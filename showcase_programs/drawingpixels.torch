include "std.torch"

const VSCREENINFO 17920 end
// TO DO: add hex notation, like the c strings -> 0x(number)
const FSCREENINFO 17922 end

memory var-info 160 end
memory fix-info 80 end


memory fbfd sizeof(u64) end
memory line-len sizeof(u64) end
memory bpp sizeof(u64) end
memory red sizeof(u64) end
memory green sizeof(u64) end
memory blue sizeof(u64) end
memory fb-size sizeof(u64) end
memory fb-ptr sizeof(ptr) end

proc main in 
0
O_RDWR
"/dev/fb0"c 
0 100 -
openat
dup 0 < if 
"ERR: couldn't open" eputs
1 exit
end
fbfd !64

var-info VSCREENINFO fbfd @64 ioctl 0 < if
"ERR: VSCREENINFO failed\n" eputs
1 exit
end

fix-info FSCREENINFO fbfd @64 ioctl 0 < if
"ERR: FSCREENINFO failed\n" eputs
1 exit
end


