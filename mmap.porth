include "std.porth"

macro fd mem end 
macro statbuf fd 8 + end

if argc 2 < do
"Usage: " eputs 0 nth_argv cstr-to-pstr eputs " <file>\n" eputs
"ERR: no input file is provided\n" eputs
1 exit
end

"File name is " puts 1 nth_argv cstr-to-pstr puts "\n" puts
 
 //flogs
O_RDONLY
//pathname
1 nth_argv
//dirfd
AT_FDCWD
opneat

if dup 0 < do 
"ERR: could not open file " eputs 1 nth_argv cstr-to-pstr eputs "\n" eputs 
1 exit 
end

"Opened file" puts

close drop
fd !64

if statbuf fd @64 fstat 0 < do
"ERR: could not determine the size of file" eputs 1 nth_argv cstr-to-pstr eputs "\n" eputs 
1 exit 
end 

statbuf stat.st_size @64 print 




