inline func ptr+ ptr int -- ptr in
  swap cast(int)
  swap cast(int)
  +
  cast(ptr)
end
inline func ptr- ptr int -- ptr in
  swap cast(int)
  swap cast(int)
  -
  cast(ptr)
end
inline func ptr!= ptr ptr -- bool in
  swap cast(int)
  swap cast(int)
  !=
end
inline func ptr= ptr ptr -- bool in
  swap cast(int)
  swap cast(int)
  =
end
inline func +ptr int ptr -- ptr in
  cast(int) + cast(ptr)
end

inline func ptr-diff ptr ptr -- int in
  swap cast(int)
  swap cast(int)
  -
end

